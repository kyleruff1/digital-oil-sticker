# Digital Oil Sticker — environment variables
#
# Copy to `.env` for local development. NEVER commit `.env` files.
# Production secrets are set via `fly secrets set` — see docs/DEVELOPMENT.md.

# Required in production. The hostname Fly serves the app on.
PHX_HOST=digital-oil-sticker.fly.dev

# Port the app binds to. Fly's proxy expects 8080.
PORT=4000

# Generate with: mix phx.gen.secret
# In production, set via: fly secrets set SECRET_KEY_BASE=<value>
SECRET_KEY_BASE=replace_me_with_mix_phx_gen_secret_output

# Path to the read-only catalog SQLite file.
# In the Docker image this is baked in at build time.
CATALOG_DATABASE_PATH=priv/catalog/catalog.sqlite3
