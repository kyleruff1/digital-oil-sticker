<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Digital Oil Sticker" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" href={~p"/images/dos-favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <%!-- No web app manifest: PWA is deferred by INV-6/INV-17/INV-19 and its
         go/no-go is DOS-M09-009. Linking one here would quietly change what
         the app promises about installability and offline use. --%>
    <meta name="theme-color" content="#159447" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Nonced, not 'unsafe-inline'. This has to run before first paint or the
         page flashes the wrong theme, so it stays inline; the per-request nonce
         is what lets exactly this script run while the CSP still refuses every
         injected one (DOS-M09-007 FR-2). --%>
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        // The default is DARK, not the OS preference. That forces a
        // distinction the stock three-way toggle blurs: "follow the system"
        // must be a stored choice, not the absence of one. The old script
        // deleted the key for "system", which was fine while system WAS the
        // default — now it would silently revert an explicit system choice to
        // dark on the next visit.
        const apply = (theme, source) => {
          document.documentElement.setAttribute("data-theme", theme === "system" ? systemTheme() : theme);
          document.documentElement.setAttribute("data-theme-source", source);
        };
        // Only a user's click writes storage. The boot-time default applies
        // dark without recording it, so we never store a preference nobody
        // expressed.
        const setTheme = (theme) => {
          localStorage.setItem("phx:theme", theme);
          apply(theme, theme === "system" ? "system" : "user");
        };
        const boot = (stored) => {
          stored ? apply(stored, stored === "system" ? "system" : "user") : apply("dark", "default");
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          boot(localStorage.getItem("phx:theme"));
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && boot(e.newValue));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
